          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/task/return", "host": [ "{{baseUrl}}" ], "path": [ "task", "return" ] }
      }
    },
    {
      "name": "21 跟踪链-退回后(RETURNED行)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const end = Date.now() + 2000;",
              "while (Date.now() < end) {}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const tracks = (body.data || {}).tracks || [];",
              "pm.test('有退回行RETURNED', () => pm.expect(tracks.some(t => t.status === 'RETURNED' && t.assignee === 'userA' && t.opinion === '退回修改')).to.be.true);",
              "pm.test('退回即终止-无经理审批环节', () => pm.expect(tracks.some(t => t.nodeName === '经理审批(免领单)')).to.be.false);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
