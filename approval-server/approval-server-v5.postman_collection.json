              "const inst = Number(pm.collectionVariables.get('instanceIdRet'));",
              "const tasks = (body.data || {}).tasks || [];",
              "const mine = tasks.filter(t => t.assignee === 'userA' && Number(t.instanceId) === inst);",
              "pm.test('userA有待办', () => pm.expect(mine.length).to.be.above(0));",
              "if (mine.length > 0) pm.collectionVariables.set('taskNoRetA', mine[0].taskNo);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"currentPage\":1,\"pageSize\":20,\"loginUser\":{\"userId\":\"userA\"}}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/task/listTodo", "host": [ "{{baseUrl}}" ], "path": [ "task", "listTodo" ] }
      }
    },
