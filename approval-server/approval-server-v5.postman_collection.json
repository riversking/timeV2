              "pm.test('链路顺序完整: 发起->领单->转交->审批->拒绝', () => {",
              "  const order = tracks.map(t => t.status);",
              "  pm.expect(order.indexOf('STARTED')).to.be.below(order.indexOf('CLAIMED'));",
              "  pm.expect(order.indexOf('CLAIMED')).to.be.below(order.indexOf('TRANSFERRED'));",
              "  pm.expect(order.indexOf('TRANSFERRED')).to.be.below(order.indexOf('APPROVED'));",
              "  pm.expect(order.indexOf('APPROVED')).to.be.below(order.indexOf('REJECTED'));",
              "});"
            ],
            "type": "text/javascript"
          }
