      "name": "28-场景4-并发认领（A、B 同时抢）",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function sendClaim(taskNo, userId) {",
              "  return new Promise((resolve) => {",
              "    pm.sendRequest({",
              "      url: pm.collectionVariables.get(\"base_url\") + \"/task/claim\",",
              "      method: \"POST\",",
              "      header: { \"Content-Type\": \"application/json\" },",
              "      body: { mode: \"raw\", raw: JSON.stringify({ taskNo: taskNo, userId: userId, loginUser: { userId: userId } }) }",
              "    }, (err, res) => resolve(res ? res.text() : String(err)));",
              "  });",
              "}",
              "const [respA, respB] = await Promise.all([",
              "  sendClaim(pm.collectionVariables.get(\"taskNoA3\"), \"userA\"),",
              "  sendClaim(pm.collectionVariables.get(\"taskNoB3\"), \"userB\")",
              "]);",
              "pm.collectionVariables.set(\"respA\", respA);",
              "pm.collectionVariables.set(\"respB\", respB);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const ra = pm.collectionVariables.get(\"respA\");",
              "const rb = pm.collectionVariables.get(\"respB\");",
              "console.log(\"并发认领-A:\", ra.slice(0, 200));",
              "console.log(\"并发认领-B:\", rb.slice(0, 200));",
              "const failA = ra.includes(\"失败\") || ra.includes(\"404\") || ra.includes(\"不存在\");",
              "const failB = rb.includes(\"失败\") || rb.includes(\"404\") || rb.includes(\"不存在\");",
              "pm.test(\"恰好一个成功\", () => (failA !== failB));"
            ]
          }
        }
