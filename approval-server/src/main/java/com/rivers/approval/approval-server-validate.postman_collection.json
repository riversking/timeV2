{
  "info": {
    "name": "approval-server 新模型全流程验证",
    "description": "flow_task 拆分新模型验证：多行候选、认领清理、转交链、CAS 归档、终止冻结、并发认领。ResultVO 字段名未知，断言采用宽松提取（data/result/payload），最终以数据库核对为准。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8081" },
    { "key": "definitionId", "value": "" },
    { "key": "instanceId", "value": "" },
    { "key": "instanceNo", "value": "" },
    { "key": "taskNoA", "value": "" },
    { "key": "taskNoB", "value": "" },
    { "key": "taskNoB2", "value": "" },
    { "key": "taskNoC", "value": "" },
    { "key": "instanceId2", "value": "" },
    { "key": "terminateTaskNo", "value": "" },
    { "key": "instanceId3", "value": "" },
    { "key": "taskNoA3", "value": "" },
    { "key": "taskNoB3", "value": "" }
  ],
  "item": [
    {
      "name": "01-创建流程定义",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const def = {",
              "  key: \"leave_v2\",",
              "  name: \"请假审批-新模型验证\",",
              "  nodes: [",
              "    { id: \"start\", type: \"START\", name: \"开始\" },",
              "    { id: \"dept\", type: \"USER_TASK\", name: \"部门审批\", config: { candidateUsers: [\"userA\", \"userB\"] } },",
              "    { id: \"mgr\", type: \"USER_TASK\", name: \"经理审批\", config: { assignee: \"userC\" } },",
              "    { id: \"end\", type: \"END\", name: \"结束\" }",
              "  ],",
              "  edges: [",
              "    { id: \"e1\", source: \"start\", target: \"dept\" },",
              "    { id: \"e2\", source: \"dept\", target: \"mgr\" },",
              "    { id: \"e3\", source: \"mgr\", target: \"end\" }",
              "  ]",
              "};",
              "const body = { definitionKey: \"leave_v2\", name: \"请假审批-新模型验证\", description: \"全流程验证\", category: \"HR\", definitionJson: JSON.stringify(def), loginUser: { username: \"admin\", userId: \"admin\" } };",
              "pm.variables.set(\"reqBody\", JSON.stringify(body));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "if (data && data.id) pm.collectionVariables.set(\"definitionId\", data.id);",
              "console.log(\"创建定义响应:\", JSON.stringify(body).slice(0, 400));",
              "pm.test(\"HTTP 200\", () => pm.response.code === 200);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{{reqBody}}" },
        "url": "{{base_url}}/flowDefinition/create"
      }
    },
    {
      "name": "02-查询最新定义（提取 definitionId）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "if (data && data.id) pm.collectionVariables.set(\"definitionId\", data.id);",
              "console.log(\"definitionId =\", pm.collectionVariables.get(\"definitionId\"));",
              "pm.test(\"拿到 definitionId\", () => !!pm.collectionVariables.get(\"definitionId\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"definitionKey\":\"leave_v2\"}" },
        "url": "{{base_url}}/flowDefinition/getLatest"
      }
    },
    {
      "name": "03-发布定义",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"发布响应:\", pm.response.text().slice(0, 300));",
              "pm.test(\"HTTP 200\", () => pm.response.code === 200);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"id\":{{definitionId}},\"loginUser\":{\"username\":\"admin\",\"userId\":\"admin\"}}" },
        "url": "{{base_url}}/flowDefinition/publish"
      }
    },
    {
      "name": "04-发起流程（提取 instanceId/instanceNo）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "if (data && data.instanceId) pm.collectionVariables.set(\"instanceId\", data.instanceId);",
              "if (data && data.instanceNo) pm.collectionVariables.set(\"instanceNo\", data.instanceNo);",
              "console.log(\"instanceId =\", pm.collectionVariables.get(\"instanceId\"), \"instanceNo =\", pm.collectionVariables.get(\"instanceNo\"));",
              "pm.test(\"拿到 instanceId\", () => !!pm.collectionVariables.get(\"instanceId\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"definitionKey\":\"leave_v2\",\"title\":\"验证单-20260905\",\"businessKey\":\"BIZ-001\",\"initiator\":\"userA\",\"initiatorName\":\"张三\",\"variables\":\"{}\",\"loginUser\":{\"username\":\"userA\",\"userId\":\"userA\"}}" },
        "url": "{{base_url}}/flow/startProcess"
      }
    },
    {
      "name": "05-A待认领（提取 taskNoA，等待引擎推进）",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": ["await new Promise(r => setTimeout(r, 3000));"] }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "const tasks = (data && data.tasks) || [];",
              "if (tasks[0]) pm.collectionVariables.set(\"taskNoA\", tasks[0].taskNo);",
              "console.log(\"A待认领:\", JSON.stringify(tasks));",
              "pm.test(\"A 有 1 条待认领\", () => tasks.length >= 1);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"currentPage\":1,\"pageSize\":10,\"loginUser\":{\"userId\":\"userA\"}}" },
        "url": "{{base_url}}/task/listClaimable"
      }
    },
    {
      "name": "06-B待认领（提取 taskNoB）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "const tasks = (data && data.tasks) || [];",
              "if (tasks[0]) pm.collectionVariables.set(\"taskNoB\", tasks[0].taskNo);",
              "console.log(\"B待认领:\", JSON.stringify(tasks));",
              "pm.test(\"B 有 1 条待认领且 taskNo 与 A 不同\", () => tasks.length >= 1 && tasks[0].taskNo !== pm.collectionVariables.get(\"taskNoA\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"currentPage\":1,\"pageSize\":10,\"loginUser\":{\"userId\":\"userB\"}}" },
        "url": "{{base_url}}/task/listClaimable"
      }
