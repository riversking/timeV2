    {
      "name": "18-实例历史事件",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const data = body.data || body.result || body.payload || body;",
              "const list = (data && (data.histories || data.list)) || [];",
              "console.log(\"历史事件数:\", list.length);",
              "list.forEach(h => console.log(h.eventType, \"taskId=\", h.taskId, \"operator=\", h.operatorId));",
              "pm.test(\"包含 TASK_CREATED / TASK_COMPLETED / INSTANCE_COMPLETED\", () => {",
              "  const types = list.map(h => h.eventType);",
              "  return types.includes(\"TASK_CREATED\") && types.includes(\"TASK_COMPLETED\") && types.includes(\"INSTANCE_COMPLETED\");",
              "});"
            ]
          }
        }
      ],
